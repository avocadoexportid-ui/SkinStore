-- Aktifkan RLS di tabel sensitif
ALTER TABLE public.orders ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.users ENABLE ROW LEVEL SECURITY;

-- Policy: Customer hanya bisa lihat order miliknya sendiri
CREATE POLICY "Customer can view own orders" ON public.orders
  FOR SELECT USING (auth.uid() = user_id);

-- Policy: Admin dan Owner bisa lihat semua order
CREATE POLICY "Admin/Owner can view all orders" ON public.orders
  FOR ALL USING (
    EXISTS (
      SELECT 1 FROM public.users WHERE id = auth.uid() AND role IN ('owner', 'admin')
    )
  );

-- Policy: Staff HANYA bisa update status order dan input resi (tidak bisa delete)
CREATE POLICY "Staff can update order status" ON public.orders
  FOR UPDATE USING (
    EXISTS (
      SELECT 1 FROM public.users WHERE id = auth.uid() AND role = 'staff'
    )
  );
