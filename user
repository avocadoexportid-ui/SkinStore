-- 1. Buat Fungsi Trigger
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS trigger AS $$
BEGIN
  INSERT INTO public.users (
    id, 
    email, 
    no_wa, 
    nama, 
    role
  )
  VALUES (
    new.id,
    new.email,
    -- Ambil dari metadata jika ada, jika tidak kosongkan sementara (di-handle form onboarding)
    COALESCE(new.raw_user_meta_data->>'no_wa', 'Belum Diisi'), 
    COALESCE(new.raw_user_meta_data->>'nama', split_part(new.email, '@', 1)), -- Default nama dari email
    'customer' -- Semua pendaftar baru default jadi customer
  );
  RETURN new;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- 2. Pasang Trigger ke tabel auth.users bawaan Supabase
CREATE OR REPLACE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();
