-- Mengaktifkan UUID extension
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- 1. USERS TABLE (Extend dari Supabase Auth)
CREATE TABLE public.users (
  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,
  email TEXT UNIQUE NOT NULL,
  no_wa TEXT UNIQUE NOT NULL,
  nama TEXT NOT NULL,
  role TEXT DEFAULT 'customer' CHECK (role IN ('owner', 'admin', 'staff', 'customer')),
  tgl_lahir DATE,
  tipe_kulit TEXT,
  poin INTEGER DEFAULT 0,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. PRODUCTS & VARIANTS
CREATE TABLE public.products (
  id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
  nama TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  brand_id UUID, -- Asumsi tabel brands sudah ada
  category_id UUID, -- Asumsi tabel categories sudah ada
  deskripsi TEXT,
  ingredients JSONB,
  bpom_no TEXT NOT NULL CHECK (bpom_no ~ '^(NA|NC|NB|ND)\d{11}$'), -- Hard strict regex di level DB
  is_active BOOLEAN DEFAULT true,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE public.product_variants (
  id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
  product_id UUID REFERENCES public.products(id) ON DELETE CASCADE,
  nama_varian TEXT NOT NULL,
  sku TEXT UNIQUE NOT NULL,
  harga NUMERIC NOT NULL,
  harga_member NUMERIC NOT NULL,
  harga_modal NUMERIC NOT NULL,
  stok INTEGER DEFAULT 0,
  berat INTEGER DEFAULT 50, -- Default 50gr
  foto_urls TEXT[],
  is_preorder BOOLEAN DEFAULT false
);

-- Index Wajib untuk pencarian cepat
CREATE INDEX idx_product_variants_sku ON public.product_variants(sku);

-- 3. ORDERS & ITEMS
CREATE TABLE public.orders (
  id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
  user_id UUID REFERENCES public.users(id),
  no_invoice TEXT UNIQUE NOT NULL,
  status TEXT DEFAULT 'pending' CHECK (status IN ('pending', 'paid', 'processing', 'shipped', 'delivered', 'cancelled', 'returned')),
  subtotal NUMERIC NOT NULL,
  ongkir NUMERIC NOT NULL,
  diskon NUMERIC DEFAULT 0,
  poin_pakai INTEGER DEFAULT 0,
  grand_total NUMERIC NOT NULL,
  alamat_json JSONB NOT NULL,
  kurir TEXT NOT NULL,
  resi TEXT,
  payment_token TEXT,
  paid_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_orders_user_id ON public.orders(user_id);
